<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.app_tabs" path="/org/gnome/shell/extensions/app_tabs/">
        <key name="ellipsize-mode" type="b">
            <default>false</default>
        </key>
        <key name="only-display-tabs-on-current-workspace" type="b">
            <default>true</default>
        </key>
        <key name="show-add-tab-button" type="b">
            <default>true</default>
        </key>
        <key name="show-recent-windows-menu" type="b">
            <default>true</default>
        </key>
        <key name="panel-max-width" type="i">
            <default>400</default>
        </key>
        <key name="app-tab-config" type="s">
            <default>
"{
    \"icon-size\": 18,
    \"default\": {
        \"default_style\": {
        },
        \"active_style\": {
        },
        \"hover_style\": {
        }
    },
    \"light_mode\": {
        \"default_style\": {
        },
        \"active_style\": {
        },
        \"hover_style\": {
        }
    },
    \"dark_mode\": {
        \"default_style\": {
        },
        \"active_style\": {
        },
        \"hover_style\": {
        }
    }
}"
            </default>
        </key>
        <key name="tabs-order" type="s">
            <default>"{}"</default>
        </key>
        <key name="recent-windows-state" type="s">
            <default>'{"opened":[],"closed":[]}'</default>
        </key>
        <key name="display-mode" type="s">
            <choices>
                <choice value="panel"/>
                <choice value="standalone"/>
            </choices>
            <default>"panel"</default>
        </key>
        <key name="hide-topbar-in-standalone" type="b">
            <default>true</default>
        </key>
        <key name="standalone-bar-position" type="s">
            <default>"{\"x\":0,\"y\":0}"</default>
        </key>
    </schema>
</schemalist>
